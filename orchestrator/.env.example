# Copy to .env (gitignored) and fill in real values.
# Load with: set -a; source .env; set +a
SAG_HTTP_ADDR=:8080
SAG_DB_DSN='user:password@tcp(127.0.0.1:3306)/flexie_sag?parseTime=true'
SAG_NATS_URL=nats://127.0.0.1:4222
SAG_WORKER_CAPABILITIES=default
SAG_BASE_URL=http://localhost:8080
# Where the two pages live. UNSET MEANS 404: the API answers perfectly and there
# is nothing at / or /chat/, which reads as a broken deployment and is a server
# with nothing to serve. Either a directory of built files or an address to
# proxy (that is how `make dev-personal` serves pages that reload).
# Where the gateway serves the pages FROM. Set BOTH, or every page is a 404
# with nothing in the log to say why. A path serves the built files; an address
# proxies a dev server, which is what `make dev-personal` uses.
#SAG_CONSOLE_DIR=/srv/console          (or http://127.0.0.1:5174)
#SAG_CHAT_DIR=/srv/chat                (or http://127.0.0.1:5173)
# Logs go to stderr (the terminal, and a container's log stream). Level, quietest
# to loudest: error, warn, info (default), debug, trace. Format: console (default,
# readable, coloured on a terminal) or json (for a log collector).
SAG_LOG_LEVEL=info
SAG_LOG_FORMAT=console
# How long a restart waits for work already under way before it gives up and
# cancels it. A ceiling, not a delay: an idle process goes down at once (KB/27).
SAG_SHUTDOWN_GRACE=1m
# How long after a refresh token is spent a replay of it is read as a client
# that never received the replacement, rather than as a stolen token. It also
# requires the same browser. 0 restores strict reuse detection, at the cost of
# signing people out when a response is lost in flight (KB/08).
SAG_REFRESH_REUSE_GRACE=1m
# 32 bytes hex, e.g. from: openssl rand -hex 32
SAG_SESSION_SECRET=
# Envelope encryption for stored secrets: id:hexkey pairs, 32 bytes each.
# Generate with: openssl rand -hex 32
SAG_ENCRYPTION_KEYS='1:REPLACE_WITH_64_HEX_CHARS'
SAG_ENCRYPTION_PRIMARY_KEY_ID=1

# Vendor keys for live smoke tests (optional; the live suite skips without them).
SAG_LIVE_ANTHROPIC_KEY=
SAG_LIVE_OPENAI_KEY=
SAG_LIVE_DEEPSEEK_KEY=

# The account `sag dev` signs in as, so nobody has to remember a password on
# their own machine. Read ONLY in dev mode: `sag server` ignores these entirely,
# and setting them on a deployment does not create the sign-in route (it is
# registered by the subcommand, never by the environment).
SAG_DEV_SIGN_IN_EMAIL=admin@acme.test
SAG_DEV_SIGN_IN_PASSWORD=
