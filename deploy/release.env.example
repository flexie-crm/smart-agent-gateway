# Where releases are published to. Copy to release.env and fill in.
#
#   cp deploy/release.env.example deploy/release.env
#
# release.env is git-ignored and must stay that way: it names a machine you own
# and the account that may write to it. The example is committed so somebody
# with a fresh checkout knows what is needed; the real one never leaves your
# disk.
#
# desktop/publish.sh reads this on its own, so nothing has to be exported by
# hand before a release.

# The machine that serves downloads, and an account that may write to it.
SAG_REPO_SSH=user@your-download-host

# Where the update archives and manifests live on that machine.
SAG_REPO_DIR=/srv/sag-repo/dist/updates

# The address the public reaches it at. The publish script fetches what it just
# uploaded back through this, to prove it is really being served.
SAG_REPO_URL=https://downloads.example.com

# Where the installers live. Defaults to a "desktop" directory beside
# SAG_REPO_DIR, which is almost always right.
#SAG_REPO_DESKTOP_DIR=/srv/sag-repo/dist/desktop
