<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Talking to the assistant instead of typing. The hardened runtime refuses
       audio hardware without this, so it is needed the moment there is a real
       Developer ID to sign with, not only when the microphone is used. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
